<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="DeliveryApp - Courier Details"
        Height="760"
        Width="500"
        MinHeight="620"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#EEF1F4"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ButtonText, StringFormat='{}{0} Courier'}"
                   Style="{StaticResource AppHeaderTitle}"
                   Margin="0,0,0,16"/>

        <!-- Form card -->
        <Border Grid.Row="1" Style="{StaticResource AppCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Labels -->
                <TextBlock Grid.Row="0"  Text="Courier ID"                Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="1"  Text="Full Name"                 Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="2"  Text="Phone"                     Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="3"  Text="Email"                     Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="4"  Text="Start Work"                Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="5"  Text="Transport Type"            Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="6"  Text="Password *"       Style="{StaticResource AppFieldLabel}" Margin="0,8"
                           Visibility="{Binding ButtonText, Converter={StaticResource ConvertAddToVisibleKey}}"/>
                <TextBlock Grid.Row="6"  Text="New Password"      Style="{StaticResource AppFieldLabel}" Margin="0,8"
                           Visibility="{Binding ButtonText, Converter={StaticResource ConvertAddToNotVisibleKey}}"/>
                <TextBlock Grid.Row="7"  Text="Is Active"                 Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="8"  Text="Max Distance (km)"         Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="9"  Text="Delivery Type"             Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="10" Text="Delivered On Time"         Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="11" Text="Delivered Late"            Style="{StaticResource AppFieldLabel}" Margin="0,8"/>
                <TextBlock Grid.Row="12" Text="Current Order ID"          Style="{StaticResource AppFieldLabel}" Margin="0,8"/>

                <!-- Inputs -->
                <TextBox Grid.Column="1" Grid.Row="0"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.CourierID}"
                         IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>
                <TextBox Grid.Column="1" Grid.Row="1"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1" Grid.Row="2"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1" Grid.Row="3"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DatePicker Grid.Column="1" Grid.Row="4" Margin="0,8" Height="40" VerticalContentAlignment="Center"
                            SelectedDate="{Binding CurrentCourier.StartWorkInCompany, Mode=TwoWay}"/>
                <ComboBox Grid.Column="1" Grid.Row="5" Margin="0,8" Height="36"
                          ItemsSource="{Binding Source={StaticResource DeliveryTransportKey}}"
                          SelectedValue="{Binding CurrentCourier.TransportType, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" Grid.Row="6"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Leave blank to keep the existing password"/>
                <CheckBox Grid.Column="1" Grid.Row="7" Margin="0,12,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" Grid.Row="8"  Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.MaxDeliveryDistanceKM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="1" Grid.Row="9" Margin="0,8" Height="36"
                          ItemsSource="{Binding Source={StaticResource DeliveryTypeKey}}"
                          SelectedValue="{Binding CurrentCourier.DeliveryType, Mode=TwoWay}"
                          IsEnabled="{Binding ButtonText, Converter={StaticResource ConvertAddToFalseKey}}"/>
                <TextBox Grid.Column="1" Grid.Row="10" Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.DeliveredInTime}" IsReadOnly="True"/>
                <TextBox Grid.Column="1" Grid.Row="11" Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentCourier.DeliveredNotInTime}" IsReadOnly="True"/>
                <TextBox Grid.Column="1" Grid.Row="12" Margin="0,8" Style="{StaticResource AppTextBox}"
                         Text="{Binding CurrentOrderID, Mode=TwoWay}"
                         IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Action -->
        <Button Grid.Row="2"
                Content="{Binding ButtonText}"
                Click="btnAddOrUpdate_Click"
                Width="200"
                Height="44"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                Style="{StaticResource AppPrimaryButton}"/>
    </Grid>
</Window>