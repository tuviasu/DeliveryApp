<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="DeliveryApp - Order Management"
        Height="640"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Center cell content so it aligns with the centered column headers -->
        <Style x:Key="CellCenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Filter by"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="180"
                              Height="34"
                              ItemsSource="{Binding Source={StaticResource OrderListFilterPropertyKey}}"
                              SelectedItem="{Binding FilterProperty, Mode=TwoWay}"
                              SelectionChanged="FilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Value"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="200"
                              Height="34"
                              ItemsSource="{Binding FilterValues, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding FilterValue, Mode=TwoWay}"
                              IsEnabled="{Binding FilterProperty, Converter={StaticResource NullableToBoolConverter}}"
                              SelectionChanged="FilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Sort by"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="180"
                              Height="34"
                              ItemsSource="{Binding Source={StaticResource OrderListSortPropertyKey}}"
                              SelectedItem="{Binding SortProperty, Mode=TwoWay}"
                              SelectionChanged="FilterChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Orders Table -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="12">

            <DataGrid ItemsSource="{Binding OrderList}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="Update_DoubleClick"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowBackground="#F9FBFC"
                      AlternatingRowBackground="#EDF3F7"
                      FontSize="13">

                <!-- FIXED HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="MinHeight" Value="42"/>
                        <Setter Property="Background" Value="#E3EAF0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID"
                                        Binding="{Binding OrderID}"
                                        Width="90"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Delivery ID"
                                        Binding="{Binding DeliveryID}"
                                        Width="100"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding orderType}"
                                        Width="100"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding orderStatus}"
                                        Width="120"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Schedule"
                                        Binding="{Binding scheduleStatus}"
                                        Width="100"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Deliveries"
                                        Binding="{Binding TotalDeliveries}"
                                        Width="90"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <!-- Remaining time only means something while the order is still open. -->
                    <DataGridTemplateColumn Header="Remaining Time"
                                            Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterText}">
                                            <Setter Property="Text" Value="{Binding TimeRemainingToComplete, Converter={StaticResource TimeSpanToReadableConverter}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding orderStatus}" Value="Delivered">
                                                    <Setter Property="Text" Value="—"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding orderStatus}" Value="CustomerRefused">
                                                    <Setter Property="Text" Value="—"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding orderStatus}" Value="Cancelled">
                                                    <Setter Property="Text" Value="—"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Handling Time"
                                        Binding="{Binding TotalHandlingTime, Converter={StaticResource TimeSpanToReadableConverter}, ConverterParameter=Duration}"
                                        Width="150"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <DataGridTextColumn Header="Air Distance (km)"
                                        Binding="{Binding AirDistance}"
                                        Width="130"
                                        ElementStyle="{StaticResource CellCenterText}"/>

                    <!-- Cancel button stays RED -->
                    <DataGridTemplateColumn Header="Cancel"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel"
                                        Click="btnCancel_Click"
                                        Style="{StaticResource AppDangerButton}"
                                        MinHeight="0"
                                        Height="30"
                                        Padding="12,4"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Visibility="{Binding orderStatus,
                                            Converter={StaticResource OrderStatusToCancelVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Content="+ Add Order"
                Width="200"
                Height="46"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Style="{StaticResource AppSuccessButton}"
                Cursor="Hand"
                Click="btnAdd_Click"/>
    </Grid>
</Window>
