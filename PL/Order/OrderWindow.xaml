<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeliveryApp - Order Details"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F4"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Order Information"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Labels -->
                <TextBlock Text="Order ID" Grid.Row="0" Margin="0,6"/>
                <TextBlock Text="Order Type" Grid.Row="1" Margin="0,6"/>
                <TextBlock Text="Device Type" Grid.Row="2" Margin="0,6"/>
                <TextBlock Text="Customer Name" Grid.Row="3" Margin="0,6"/>
                <TextBlock Text="Phone" Grid.Row="4" Margin="0,6"/>
                <TextBlock Text="Address" Grid.Row="5" Margin="0,6"/>
                <TextBlock Text="Description" Grid.Row="6" Margin="0,6"/>
                <TextBlock Text="Open Time" Grid.Row="7" Margin="0,6"/>
                <TextBlock Text="Max By" Grid.Row="8" Margin="0,6"/>

                <!-- Fields -->
                <TextBox Grid.Column="1" Grid.Row="0"
                         Text="{Binding CurrentOrder.OrderID, Mode=OneWay}"
                         IsReadOnly="True"
                         Margin="0,6"/>

                <ComboBox Grid.Column="1" Grid.Row="1"
                          ItemsSource="{Binding Source={StaticResource OrderTypeKey}}"
                          SelectedValue="{Binding SelectedOrderType, Mode=TwoWay}"
                          Margin="0,6"/>

                <ComboBox Grid.Column="1" Grid.Row="2"
                          ItemsSource="{Binding Source={StaticResource PizzaSizeKey}}"
                          SelectedValue="{Binding CurrentOrder.PizzaSize, Mode=TwoWay}"
                          Margin="0,6"/>

                <TextBox Grid.Column="1" Grid.Row="3"
                         Text="{Binding CurrentOrder.CustomerFullName, Mode=TwoWay}"
                         Margin="0,6"/>

                <TextBox Grid.Column="1" Grid.Row="4"
                         Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay}"
                         Margin="0,6"/>

                <TextBox Grid.Column="1" Grid.Row="5"
                         Text="{Binding CurrentOrder.FullAddress, Mode=TwoWay}"
                         Margin="0,6"/>

                <TextBox Grid.Column="1" Grid.Row="6"
                         Text="{Binding CurrentOrder.Description, Mode=TwoWay}"
                         Margin="0,6"/>

                <!-- Non-scheduled -->
                <TextBox Grid.Column="1" Grid.Row="7"
                         Text="{Binding CurrentOrder.OrderOpenTime, Converter={StaticResource ForceDataFormatKey}}"
                         IsReadOnly="True"
                         Margin="0,6"
                         Visibility="{Binding IsScheduled, Converter={StaticResource InverseBoolToVisibilityKey}}"/>

                <TextBox Grid.Column="1" Grid.Row="8"
                         Text="{Binding CurrentOrder.MaxDeliveryTime, Converter={StaticResource ForceDataFormatKey}}"
                         IsReadOnly="True"
                         Margin="0,6"
                         Visibility="{Binding IsScheduled, Converter={StaticResource InverseBoolToVisibilityKey}}"/>

                <!-- Scheduled -->
                <StackPanel Grid.Column="1" Grid.Row="7"
                            Orientation="Horizontal"
                            Margin="0,6"
                            Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibilityKey}}">
                    <DatePicker Width="130"
                                SelectedDate="{Binding ScheduledDate, Mode=TwoWay}"/>
                    <TextBox Width="90"
                             Margin="10,0,0,0"
                             Text="{Binding ScheduledTimeText, Mode=TwoWay}"/>
                </StackPanel>

                <TextBox Grid.Column="1" Grid.Row="8"
                         Text="{Binding CurrentOrder.MaxDeliveryTime, Converter={StaticResource ForceDataFormatKey}}"
                         IsReadOnly="True"
                         Margin="0,6"
                         Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibilityKey}}"/>

                <!-- Deliveries -->
                <GroupBox Grid.Row="9"
                          Grid.ColumnSpan="2"
                          Header="Deliveries"
                          Margin="0,18,0,0">

                    <DataGrid AutoGenerateColumns="False"
                              ItemsSource="{Binding CurrentOrder.DeliveriesForOrder}"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Margin="6"
                              MinHeight="80">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="Background" Value="#EEF2F6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding DeliveryID}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Courier"
                                                Binding="{Binding CourierName}"
                                                Width="160"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding DeliveryType}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Start"
                                                Binding="{Binding DeliveryStartTime}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding deliveryDoneType}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Done Time"
                                                Binding="{Binding DeliveryDoneTime}"
                                                Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Border>

        <!-- Validation error + Buttons -->
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0">

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityKey}}"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Cancel Order"
                        Click="btnCancel_Click"
                        IsEnabled="{Binding CanCancel}"
                        Width="150"
                        Height="40"
                        Margin="0,0,12,0"
                        Style="{StaticResource AppDangerButton}"/>

                <Button Content="{Binding ButtonText}"
                        Click="btnAddOrUpdate_Click"
                        Width="150"
                        Height="40"
                        Style="{StaticResource AppPrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
