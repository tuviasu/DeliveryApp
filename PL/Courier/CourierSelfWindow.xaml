<Window x:Class="PL.Courier.CourierSelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeliveryApp - Courier Portal"
        Height="720"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F6"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Courier Dashboard"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#1E3A8A"
                       DockPanel.Dock="Left"/>
        </DockPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COURIER DETAILS -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="14"
                    Padding="18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Courier Details"
                               Grid.ColumnSpan="2"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="ID"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding CurrentCourier.CourierID}"
                             IsReadOnly="True"/>

                    <TextBlock Grid.Row="2" Text="Full Name" Margin="0,8,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding CurrentCourier.FullName, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Text="Phone" Margin="0,8,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding CurrentCourier.Phone, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Text="Email" Margin="0,8,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding CurrentCourier.Email, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="5" Text="Start Work" Margin="0,8,0,0"/>
                    <DatePicker Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                                SelectedDate="{Binding CurrentCourier.StartWorkInCompany}"
                                IsEnabled="False"/>

                    <TextBlock Grid.Row="6" Text="Transport" Margin="0,8,0,0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Source={StaticResource DeliveryTransportKey}}"
                              SelectedValue="{Binding CurrentCourier.TransportType}"
                              IsEnabled="{Binding CanChooseOrder}"/>

                    <TextBlock Grid.Row="7" Text="Max Distance (km)" Margin="0,8,0,0"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding CurrentCourier.MaxDeliveryDistanceKM}"/>

                    <TextBlock Grid.Row="8" Text="Delivery Type" Margin="0,8,0,0"/>
                    <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Source={StaticResource DeliveryTypeKey}}"
                              SelectedValue="{Binding CurrentCourier.DeliveryType}"
                              IsEnabled="{Binding CanChooseOrder}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Margin="8,8,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="Not Set" Foreground="#94A3B8"
                               Visibility="{Binding CurrentCourier.DeliveryType, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <TextBlock Grid.Row="9" Text="Active" Margin="0,8,0,0"/>
                    <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,8,0,0"
                              IsChecked="{Binding CurrentCourier.IsActive}"
                              IsEnabled="False"/>

                    <Button Grid.Row="10" Grid.ColumnSpan="2"
                            Content="Update Details"
                            Click="btnUpdate_Click"
                            Height="40"
                            Margin="0,18,0,0"
                            Style="{StaticResource AppPrimaryButton}"/>
                </Grid>
            </Border>

            <!-- ORDER IN PROGRESS -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="14"
                    Padding="18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="Order In Progress"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>
                        <Border Margin="10,2,0,2"
                                CornerRadius="6"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{Binding CurrentCourier.orderInProgress.scheduleStatus, Converter={StaticResource ScheduleStatusToBackgroundKey}}"
                                Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}">
                            <TextBlock Text="{Binding CurrentCourier.orderInProgress.scheduleStatus, Converter={StaticResource ScheduleStatusToTextKey}}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Delivery ID"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.DeliveryID}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="2" Text="Order ID"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.OrderID}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="3" Text="Type"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.orderType}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="4" Text="Address"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.FullAddress}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Height="60"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="5" Text="Customer"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.InviterFullName}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="6" Text="Phone"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.InviterPhone}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="7" Text="Start Time"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Text="{Binding CurrentCourier.orderInProgress.DeliveryStartTime}"
                             IsReadOnly="True"
                             Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>

                    <TextBlock Grid.Row="8" Text="Deadline (Max By)"
                               Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,8,0,0"
                                Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}">
                        <TextBox Text="{Binding CurrentCourier.orderInProgress.MaxDeliveryTime}"
                                 IsReadOnly="True"/>
                        <TextBlock Text="{Binding CurrentCourier.orderInProgress.TimeRemainingToComplete, Converter={StaticResource TimeSpanToReadableConverter}}"
                                   Foreground="{Binding CurrentCourier.orderInProgress.scheduleStatus, Converter={StaticResource ScheduleStatusToBackgroundKey}}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="2,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding CanFinishHandling, Converter={StaticResource BoolToVisibilityKey}}">
                            <TextBlock Text="Finish Type"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbFinishType"
                                      Width="180"
                                      ItemsSource="{Binding Source={StaticResource DeliveryDoneTypeKey}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">
                            <Button Content="Choose Order"
                                    Width="140"
                                    Margin="0,0,10,0"
                                    Click="btnChooseOrder_Click"
                                    IsEnabled="{Binding CanChooseOrder}"
                                    Style="{StaticResource AppSecondaryButton}"/>

                            <Button Content="Finish Handling"
                                    Width="140"
                                    Click="btnFinishHandling_Click"
                                    IsEnabled="{Binding CanFinishHandling}"
                                    Style="{StaticResource AppPrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Delivery History"
                    Click="btnHistory_Click"
                    Width="160"
                    Height="40"
                    Margin="0,0,10,0"
                    Style="{StaticResource AppPrimaryButton}"/>

            <Button Content="Log Out"
                    Click="btnLOGOUT_Click"
                    Width="120"
                    Height="40"
                    Style="{StaticResource AppDangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
