<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             xmlns:conv="clr-namespace:PL"
             StartupUri="LoginPage.xaml">
    <Application.Resources>
        <!-- enum collections live in `PL` namespace (PL\Enums.cs) -->
        <local:DeliveryTransport x:Key="DeliveryTransportKey" />
        <local:DeliveryType x:Key="DeliveryTypeKey" />
        <local:DeliveryDoneType x:Key="DeliveryDoneTypeKey" />
        <local:ScheduleStatus x:Key="ScheduleStatusKey" />
        <local:OrderType x:Key="OrderTypeKey" />
        <local:OrderStatus x:Key="OrderStatusKey" />
        <local:PizzaSize x:Key="PizzaSizeKey" />
        <local:OrderListFilterProperty x:Key="OrderListFilterPropertyKey" />
        <local:OrderListSortProperty x:Key="OrderListSortPropertyKey" />

        <!-- converters live in `PL` namespace (PL\Converters\*.cs) -->
        <conv:ConverterUpdateToTrue x:Key="ConvertUpdateToTrueKey" />
        <conv:ConverterAddToTrue x:Key="ConvertAddToTrueKey" />
        <conv:ConverterAddToFalse x:Key="ConvertAddToFalseKey" />
        <conv:ConverterUpdateToVisible x:Key="ConvertUpdateToVisibleKey" />
        <conv:ForceDataFormatConverter x:Key="ForceDataFormatKey" />
        <conv:ConvertAddToVisibleKey x:Key="ConvertAddToVisibleKey" />
        <conv:ConvertAddToNotVisibleKey x:Key="ConvertAddToNotVisibleKey" />
        <conv:TransportTypeToBackgroundConverter x:Key="TransportTypeToBackgroundKey" />
        <conv:DeliveryTypeToBackgroundConverter x:Key="DeliveryTypeToBackgroundKey" />
        <conv:DeliveryTypeToTextConverter x:Key="DeliveryTypeToTextKey" />
        <conv:DeliveryTypeToForegroundConverter x:Key="DeliveryTypeToForegroundKey" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityKey" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityKey" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanKey" />
        <conv:OrderStatusToCancelVisibilityConverter x:Key="OrderStatusToCancelVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NullableToBoolConverter x:Key="NullableToBoolConverter" />
        <conv:TimeSpanToReadableConverter x:Key="TimeSpanToReadableConverter" />

        <!-- ============================================================ -->
        <!-- SHARED MODERN THEME (used across all windows for consistency)-->
        <!-- Palette: deep slate + electric blue / indigo (premium tech)  -->
        <!-- ============================================================ -->

        <!-- Brand brushes -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandPrimaryDark" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="BrandIndigo" Color="#4F46E5"/>
        <SolidColorBrush x:Key="BrandSlate" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrandSlateLight" Color="#334155"/>
        <SolidColorBrush x:Key="BrandMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandDanger" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandDangerDark" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrandSuccess" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrandSuccessDark" Color="#15803D"/>
        <SolidColorBrush x:Key="BrandSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrandSecondaryBg" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BrandSecondaryFg" Color="#334155"/>

        <!-- Primary gradient (blue -> indigo) -->
        <LinearGradientBrush x:Key="BrandPrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandPrimaryGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#4338CA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandDangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF4444" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandSuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22C55E" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Card container (rounded + subtle shadow) -->
        <Style x:Key="AppCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrandSurface}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section / header titles -->
        <Style x:Key="AppHeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandSlate}"/>
        </Style>
        <Style x:Key="AppSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandSlate}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="AppFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandSlateLight}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Polished text input (rounded, focus highlight) -->
        <Style x:Key="AppTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Validated text input: extends AppTextBox with a red border + error
             tooltip when INotifyDataErrorInfo / IDataErrorInfo reports a validation
             error for the bound property. -->
        <Style x:Key="AppValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource BrandDanger}" BorderThickness="2" CornerRadius="10">
                            <AdornedElementPlaceholder/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self},
                            Path=(Validation.Errors)[0].ErrorContent}"/>
        </Style>

        <!-- Primary button (gradient, rounded, hover/press) -->
        <Style x:Key="AppPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandPrimaryGradientHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandPrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary / neutral button -->
        <Style x:Key="AppSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandSecondaryBg}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryFg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="AppDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandDangerGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandDangerDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success button -->
        <Style x:Key="AppSuccessButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandSuccessGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandSuccessDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
