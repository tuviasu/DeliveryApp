<Window x:Class="PL.Courier.ChooseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeliveryApp - Available Orders"
        Height="540"
        Width="900"
        MinHeight="480"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White"
                CornerRadius="14"
                Padding="16"
                Grid.Row="0">
            <DockPanel>
                <TextBlock Text="Select Order for Handling"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           DockPanel.Dock="Left"/>

                <Button Content="Close"
                        Width="90"
                        Height="34"
                        Click="btnClose_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AppSecondaryButton}"/>
            </DockPanel>
        </Border>

        <!-- Orders Grid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="12">

            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowBackground="#F9FAFB"
                      AlternatingRowBackground="#FFFFFF"
                      ColumnWidth="*">

                <!-- Header style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Background" Value="#EEF2F7"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Cell style -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID"
                                        Binding="{Binding OrderID}"
                                        Width="0.8*"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding orderType}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding FullAddress}"
                                        Width="2*"
                                        MinWidth="160"/>

                    <DataGridTextColumn Header="Air Distance (km)"
                                        Binding="{Binding AirDistance, StringFormat={}{0:F1}}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Schedule"
                                        Binding="{Binding scheduleStatus}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Time Remaining"
                                        Binding="{Binding TimeRemainingToComplete, Converter={StaticResource TimeSpanToReadableConverter}}"
                                        Width="1.3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Refresh List"
                    Width="140"
                    Height="38"
                    Click="btnRefresh_Click"
                    Margin="0,0,12,0"
                    Style="{StaticResource AppSecondaryButton}"/>

            <Button Content="Select Order"
                    Width="140"
                    Height="38"
                    Click="btnSelect_Click"
                    Style="{StaticResource AppPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
