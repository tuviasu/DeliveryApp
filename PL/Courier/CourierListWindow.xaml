<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="DeliveryApp - Courier Management"
        Height="640"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- Main container -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Filter Bar -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Filter by transport"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#333"/>

                <ComboBox Grid.Column="1"
                          Margin="16,0,0,0"
                          Height="36"
                          ItemsSource="{Binding Source={StaticResource DeliveryTransportKey}}"
                          SelectedValue="{Binding Path=TransportType, Mode=TwoWay}"
                          SelectionChanged="FilterChanged"
                          FontSize="14"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="10">
            <DataGrid ItemsSource="{Binding CourierList}"
                      SelectedItem="{Binding SelectedCourier}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="Update_DoubleClick"
                      HeadersVisibility="Column"
                      RowBackground="#FAFAFA"
                      AlternatingRowBackground="#F0F2F5"
                      GridLinesVisibility="None"
                      FontSize="13">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CourierID}"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartWorkInCompany}"/>

                    <DataGridTemplateColumn Header="Transport">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Padding="6"
                                        Background="{Binding TransportType, Converter={StaticResource TransportTypeToBackgroundKey}}">
                                    <TextBlock Text="{Binding TransportType}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}"/>
                    <DataGridTextColumn Header="Max Distance (KM)" Binding="{Binding MaxDeliveryDistanceKM}"/>

                    <DataGridTemplateColumn Header="Delivery Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Padding="6,4"
                                        Background="{Binding DeliveryType, Converter={StaticResource DeliveryTypeToBackgroundKey}}">
                                    <TextBlock Text="{Binding DeliveryType, Converter={StaticResource DeliveryTypeToTextKey}}"
                                               Foreground="{Binding DeliveryType, Converter={StaticResource DeliveryTypeToForegroundKey}}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="On Time" Binding="{Binding DeliveredInTime}"/>
                    <DataGridTextColumn Header="Late" Binding="{Binding DeliveredNotInTime}"/>
                    <DataGridTextColumn Header="Current Order"
                                        Binding="{Binding orderInProgress.OrderID}"/>

                    <DataGridTemplateColumn Header="Delete">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Click="btnDelete_Click"
                                        Style="{StaticResource AppDangerButton}"
                                        MinHeight="0"
                                        Height="30"
                                        Padding="12,4"
                                        FontSize="12"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Content="+ Add Courier"
                Width="200"
                Height="46"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Style="{StaticResource AppPrimaryButton}"
                Cursor="Hand"
                Click="btnAdd_Click"/>
    </Grid>
</Window>
